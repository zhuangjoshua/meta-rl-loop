[Unit]
Description=Takyon Dashboard
After=network-online.target
Wants=network-online.target
After=docker.service
Wants=docker.service
After=takyon-docker-broker.service
Wants=takyon-docker-broker.service

[Service]
Type=simple
# Least privilege: run as the dedicated `takyon` system user (created by bootstrap-host.sh) with
# the filesystem read-only except /opt/takyon state — and the runtime tree itself pinned read-only
# inside that, so a compromised runtime cannot rewrite its own code. Docker authority now lives in
# the dedicated takyon-docker-broker.service; this plane talks to it through the tracked
# TAKYON_DOCKER_BINARY shim instead of holding the daemon socket directly.
User=takyon
Group=takyon
NoNewPrivileges=true
PrivateTmp=true
# Product-action sandbox carve-out: scheduled actions run here (the worker plane) via
# `systemd-run --user --scope` (app_actions.py), which needs the takyon (uid 995) user-manager bus at
# /run/user/995. Plain ProtectHome=true blanks /run/user inside the namespace; ProtectHome=tmpfs +
# BindPaths re-exposes ONLY takyon's own runtime dir (the user-manager socket, not the docker/system
# daemon socket). The `%U` specifier resolves to the MANAGER uid (0) on this systemd, so the literal
# takyon uid is required. All other isolation (NoNewPrivileges, ProtectSystem=strict, deno
# --deny-write/--no-remote/scoped --allow-net, cgroup CPU/Mem/Tasks caps) is unchanged.
ProtectHome=tmpfs
BindPaths=/run/user/995
ProtectSystem=strict
ReadWritePaths=/opt/takyon
ReadOnlyPaths=/opt/takyon/hermes-agent-main
WorkingDirectory=/opt/takyon/hermes-agent-main
EnvironmentFile=-/opt/takyon/.takyon/.env
EnvironmentFile=-/opt/takyon/secrets/.env
# Client planes may read non-secret runtime config from the env files, but paid-provider
# credentials must stay behind the safebox/broker authority and must not be resident in
# dashboard process env.
UnsetEnvironment=ANTHROPIC_API_KEY ANTHROPIC_TOKEN CLAUDE_CODE_OAUTH_TOKEN OPENAI_API_KEY OPENAI_KEY AZURE_OPENAI_API_KEY AZURE_OPENAI_KEY TAVILY_API_KEY TAKYON_GEMINI_API_KEY GEMINI_API_KEY GOOGLE_API_KEY FAL_KEY FAL_API_KEY REPLICATE_API_TOKEN COMPOSIO_API_KEY
Environment=TAKYON_HOME=/opt/takyon/.takyon
Environment=HOME=/opt/takyon
Environment=PYTHONUNBUFFERED=1
Environment=TAKYON_FORCE_RESTORE_BUNDLED_SKILLS=1
# Long operator tool runs (claude.agent_task, product.surface_refresh) execute on the durable
# worker plane (takyon-worker.service) instead of inline in this process: the tool enqueues, waits
# on the canonical work-request run row, and a PTY refresh/disconnect no longer kills the run.
# Requires the worker service to be active; remove this line to fall back to inline execution.
Environment=TAKYON_OPERATOR_TASKS_VIA_WORKER=1
# Per-session operator identity, stage ENFORCE (bind -> observe -> enforce): every dashboard
# session resolves its principal from the authenticated session path (auth0/local dashboard
# principal -> PTY child / slash-worker / detached-command TAKYON_SESSION_USER_ID env, ws transport
# principal, or server-injected RPC param). A missing or wrong principal is DENIED. This mode also
# disables the legacy process-global TAKYON_OPERATOR_USER_ID as an identity source on this plane
# (core.operator_identity_mode), so no env or request-param fallback can satisfy per-session
# identity. Declared system serving surfaces (TakyonStore(system_plane=...)) are exempt by
# explicit construction-site code only.
Environment=TAKYON_REQUIRE_OPERATOR_IDENTITY=enforce
Environment=TAKYON_HOST_ROLE=operator
Environment=TAKYON_NODE_NAME=argon-alpha-14
Environment=TAKYON_PRODUCT_ACTIVATION_NODE=argon-alpha-14
# Product subdomains publish to coscale.app: this operator runtime mints <slug>.coscale.app publish
# URLs and gates on-demand TLS; CLOUDFLARE_ZONE_NAME targets the coscale zone for per-publish edge routes.
Environment=PUBLIC_COMPANY_BASE_DOMAIN=coscale.app
Environment=CLOUDFLARE_ZONE_NAME=coscale.app
Environment=TAKYON_STORAGE_BACKEND=supabase_s3
Environment=TAKYON_DASHBOARD_EMBEDDED_WORKER=0
Environment=TAKYON_SAFEBOX_URL=http://10.116.0.2:8000
Environment=TAKYON_PROVIDER_BROKER=1
Environment=TAKYON_DOCKER_BROKER_URL=http://127.0.0.1:8011
Environment=TAKYON_DOCKER_BINARY=/opt/takyon/hermes-agent-main/scripts/takyon-docker-broker.py
Environment=TERMINAL_ENV=docker
Environment=TERMINAL_DOCKER_MOUNT_CWD_TO_WORKSPACE=true
Environment=TERMINAL_CONTAINER_PERSISTENT=false
# Serving backend = Postgres (Supabase control plane). The runtime reads TAKYON_DB_BACKEND
# (core._db_backend, default "sqlite"); this line is the Phase-8 serving flip that points the live
# dashboard at the Postgres operator store + both ledgers via DATABASE_URL (Supabase pgbouncer 6543).
# Requires psycopg[binary] in the venv (pyproject `postgres` extra) — installed manually because the
# deploy never installs Python deps. Revert the flip by deleting this one line and redeploying.
Environment=TAKYON_DB_BACKEND=postgres
ExecStart=/opt/takyon/hermes-agent-main/.venv/bin/takyon-cli dashboard --host 127.0.0.1 --port 9119 --no-open --skip-build --tui
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
