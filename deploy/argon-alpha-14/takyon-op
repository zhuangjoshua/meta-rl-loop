#!/usr/bin/env bash
set -euo pipefail

# Operator-only convenience launcher for the live Takyon CLI on argon-alpha-14.
# Installed only by deploy/argon-alpha-14/deploy-runtime.sh. It never grants power by itself:
# the operator host's locked-down service env and SSH boundary remain the authority boundary.

RUNTIME_DIR="${TAKYON_REMOTE_RUNTIME:-/opt/takyon/hermes-agent-main}"
TAKYON_HOME_DIR="${TAKYON_HOME:-/opt/takyon/.takyon}"
TAKYON_SERVICE="${TAKYON_OPERATOR_SERVICE:-takyon-dashboard.service}"
DEFAULT_OPERATOR_USER_ID="${TAKYON_DEFAULT_OPERATOR_USER_ID:-150e4213-4006-4dc1-9cf3-ca7ab3b4696f}"

usage() {
  cat <<'EOF'
usage:
  takyon-op [business]
  takyon-op shell [business]
  takyon-op --no-logs [business]
  takyon-op profile-access grant <business> <email> --plan <plan-key>
  takyon-op profile-access revoke <business> <email>
  takyon-op profile-access list [--business <business>] [--email <email>]
  takyon-op -- <raw takyon args...>

Starts the operator Takyon shell on the operator VPS with logs scoped to the active business.
Inside the shell:
  /businesses          list businesses
  /use <business>      switch business scope
  /commands            show controls
  exit                 leave the shell
EOF
}

die() {
  echo "takyon-op: $*" >&2
  exit 1
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

[[ -x "$RUNTIME_DIR/takyon" ]] || die "runtime CLI not found at $RUNTIME_DIR/takyon"
[[ "$(id -u)" == "0" ]] || die "run as root on the operator VPS"
command -v systemctl >/dev/null 2>&1 || die "systemctl is required; this wrapper is for the operator VPS"
id -u takyon >/dev/null 2>&1 || die "takyon service user missing; this wrapper is for the operator VPS"

unit_env="$(systemctl show "$TAKYON_SERVICE" -p Environment --value 2>/dev/null || true)"
if [[ "$unit_env" != *"TAKYON_HOST_ROLE=operator"* ]]; then
  die "$TAKYON_SERVICE is not an operator service; refusing to start operator CLI"
fi
if systemctl cat takyon-subuser.service >/dev/null 2>&1; then
  die "sub-user service is present on this host; refusing to expose operator CLI"
fi

dashboard_pid="$(systemctl show -p MainPID --value "$TAKYON_SERVICE" 2>/dev/null || true)"
if [[ -z "$dashboard_pid" || "$dashboard_pid" == "0" || ! -r "/proc/$dashboard_pid/environ" ]]; then
  die "$TAKYON_SERVICE is not running or its env is unreadable"
fi

# This command intentionally never enters the normal Takyon CLI and never drops to the `takyon`
# service user. The Python entrypoint independently requires euid 0 + SSH_CONNECTION + the operator
# host role and reads only the dedicated root-owned least-privilege DB credential. The environment
# is rebuilt from scratch and pinned to prod: caller exports and service secrets cannot influence
# this rail. `/usr/local/bin/takyon-op` is installed root:root mode 0750 only on this operator host;
# the sub-user deploy does not install it.
if [[ "${1:-}" == "profile-access" ]]; then
  [[ -x "$RUNTIME_DIR/.venv/bin/python" ]] || die "runtime Python not found"
  [[ -n "${SSH_CONNECTION:-}" ]] || die "profile-access requires an SSH session"
  command -v sshd >/dev/null 2>&1 || die "sshd is required to verify key-only root access"
  ssh_client="${SSH_CONNECTION%% *}"
  ssh_host="$(hostname -f 2>/dev/null || hostname)"
  sshd_effective="$(sshd -T -C "user=root,host=$ssh_host,addr=$ssh_client" 2>/dev/null)" \
    || die "could not verify effective root SSH policy"
  for required in \
    "pubkeyauthentication yes" \
    "passwordauthentication no" \
    "kbdinteractiveauthentication no" \
    "hostbasedauthentication no" \
    "gssapiauthentication no" \
    "kerberosauthentication no"; do
    grep -Fqx -- "$required" <<<"$sshd_effective" \
      || die "root SSH is not key-only ($required required)"
  done
  shift
  cd "$RUNTIME_DIR"
  exec env -i \
    PATH=/usr/sbin:/usr/bin:/sbin:/bin \
    HOME=/root \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH="$RUNTIME_DIR" \
    SSH_CONNECTION="$SSH_CONNECTION" \
    TAKYON_ENV=prod \
    TAKYON_HOST_ROLE=operator \
    TAKYON_STRIPE_MODE=live \
    "$RUNTIME_DIR/.venv/bin/python" -m plugins.takyon.operator_access "$@"
fi

service_env_value() {
  tr '\0' '\n' <"/proc/$dashboard_pid/environ" | awk -F= -v key="$1" '$1 == key {sub(/^[^=]*=/, ""); print; exit}'
}

safe_url="$(service_env_value TAKYON_SAFEBOX_URL)"
safe_token="$(service_env_value TAKYON_SAFEBOX_TOKEN)"
stripe_mode="$(service_env_value TAKYON_STRIPE_MODE)"
[[ -n "$safe_url" ]] || die "TAKYON_SAFEBOX_URL missing from $TAKYON_SERVICE env"
[[ -n "$safe_token" ]] || die "TAKYON_SAFEBOX_TOKEN missing from $TAKYON_SERVICE env"
[[ "$stripe_mode" == "live" ]] || die "TAKYON_STRIPE_MODE is not live in $TAKYON_SERVICE"

strict_model_roles="$(service_env_value TAKYON_STRICT_MODEL_ROLES)"
ceo_model="$(service_env_value TAKYON_MODEL)"
worker_model="$(service_env_value TAKYON_CLAUDE_AGENT_MODEL)"
anthropic_model="$(service_env_value ANTHROPIC_MODEL)"
opus_model="$(service_env_value ANTHROPIC_DEFAULT_OPUS_MODEL)"
sonnet_model="$(service_env_value ANTHROPIC_DEFAULT_SONNET_MODEL)"
haiku_model="$(service_env_value ANTHROPIC_DEFAULT_HAIKU_MODEL)"
subagent_model="$(service_env_value CLAUDE_CODE_SUBAGENT_MODEL)"
skills_plugin="$(service_env_value TAKYON_CLAUDE_SKILLS_PLUGIN)"
skills_manifest="$(service_env_value TAKYON_CLAUDE_SKILLS_MANIFEST)"
node_runtime="$(service_env_value TAKYON_CLAUDE_NODE_RUNTIME)"
primary_budget="$(service_env_value TAKYON_PRIMARY_AGENT_MAX_BUDGET_USD)"
primary_per_call_budget="$(service_env_value TAKYON_PRIMARY_AGENT_PER_CALL_MAX_BUDGET_USD)"
operator_session_max_cost="$(service_env_value TAKYON_OPERATOR_SESSION_MAX_COST_MICROUSD)"
[[ "$strict_model_roles" == "1" ]] || die "strict model roles are not enabled in $TAKYON_SERVICE"
[[ "$ceo_model" == "deepseek-v4-pro" ]] || die "primary agent model pin is not deepseek-v4-pro in $TAKYON_SERVICE"
for model_value in "$worker_model" "$anthropic_model" "$opus_model" "$sonnet_model" "$haiku_model" "$subagent_model"; do
  [[ "$model_value" == "deepseek-v4-pro" ]] \
    || die "Agent SDK model aliases are not all deepseek-v4-pro in $TAKYON_SERVICE"
done
[[ -r "$skills_plugin/.claude-plugin/plugin.json" ]] || die "approved skills plugin is unavailable"
[[ -r "$skills_manifest" ]] || die "approved skills manifest is unavailable"
[[ -r "$node_runtime/node_modules/@anthropic-ai/claude-agent-sdk/sdk.mjs" ]] \
  || die "pinned Claude Agent SDK runtime is unavailable"
[[ "$primary_budget" == "5" ]] || die "primary SDK total budget pin is invalid"
[[ "$primary_per_call_budget" == "2" ]] || die "primary SDK per-call budget pin is invalid"
[[ "$operator_session_max_cost" == "2000000" ]] || die "operator session cost pin is invalid"

logs=1
args=("$@")
if [[ "${args[0]:-}" == "--no-logs" ]]; then
  logs=0
  args=("${args[@]:1}")
fi

if [[ "${args[0]:-}" == "--" ]]; then
  args=("${args[@]:1}")
else
  if [[ "${args[0]:-}" == "shell" ]]; then
    args=("${args[@]:1}")
  fi
  business="${args[0]:-}"
  args=("shell")
  if [[ -n "$business" ]]; then
    args+=("$business")
  fi
fi

if [[ "$logs" == "1" ]]; then
  args=("--logs" "${args[@]}")
fi

export TAKYON_HOME="$TAKYON_HOME_DIR"
export HOME=/opt/takyon
export TAKYON_ENV=prod
export TAKYON_HOST_ROLE=operator
export TAKYON_STRIPE_MODE="$stripe_mode"
export TAKYON_SAFEBOX_URL="$safe_url"
export TAKYON_SAFEBOX_TOKEN="$safe_token"
export TAKYON_STRICT_MODEL_ROLES="$strict_model_roles"
export TAKYON_MODEL="$ceo_model"
export TAKYON_CLAUDE_AGENT_MODEL="$worker_model"
export ANTHROPIC_MODEL="$anthropic_model"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$opus_model"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$sonnet_model"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$haiku_model"
export CLAUDE_CODE_SUBAGENT_MODEL="$subagent_model"
export TAKYON_CLAUDE_SKILLS_PLUGIN="$skills_plugin"
export TAKYON_CLAUDE_SKILLS_MANIFEST="$skills_manifest"
export TAKYON_CLAUDE_NODE_RUNTIME="$node_runtime"
export TAKYON_DISABLE_LEGACY_SKILL_SYNC=1
export TAKYON_PRIMARY_AGENT_MAX_BUDGET_USD="$primary_budget"
export TAKYON_PRIMARY_AGENT_PER_CALL_MAX_BUDGET_USD="$primary_per_call_budget"
export TAKYON_OPERATOR_SESSION_MAX_COST_MICROUSD="$operator_session_max_cost"
export TAKYON_SESSION_USER_ID="${TAKYON_SESSION_USER_ID:-$DEFAULT_OPERATOR_USER_ID}"

exec runuser -u takyon -- "$RUNTIME_DIR/takyon" "${args[@]}"
