# Takyon Postgres worker-drain plane.
#
# This unit is the canonical definition for the Phase-6 worker process (the Postgres-native
# replacement for the legacy file-cron CEO wakeups). The tracked VPS deploy now ships this unit and
# enables/restarts it whenever the dashboard service is configured for the Postgres backend. That
# keeps recurring PG wake schedules draining on the same deploy rail as the dashboard without
# requiring a second manual activation step.
#
# Only ONE worker should run per deployment (jobs are claimed FOR UPDATE SKIP LOCKED, so extra
# workers are safe but redundant). With the worker self-dispatching due wakes, pg_cron is OPTIONAL;
# pass --no-dispatch here if pg_cron owns dispatch instead.

[Unit]
Description=Takyon Worker (Postgres job drain + CEO wake dispatch)
After=network-online.target
Wants=network-online.target
After=docker.service
Wants=docker.service
After=takyon-docker-broker.service
Wants=takyon-docker-broker.service

[Service]
Type=simple
# Least privilege: same posture as takyon-dashboard.service — dedicated `takyon` user, filesystem
# read-only except /opt/takyon state, runtime tree pinned read-only. Docker authority now lives in
# the dedicated takyon-docker-broker.service; this worker talks to it through the tracked
# TAKYON_DOCKER_BINARY shim instead of holding the daemon socket directly.
User=takyon
Group=takyon
NoNewPrivileges=true
PrivateTmp=true
# Product-action sandbox carve-out: execute_scheduled_action -> invoke_action wraps the deno action
# in `systemd-run --user --scope`, which needs the takyon (uid 995) user-manager bus at /run/user/995.
# ProtectHome=tmpfs + BindPaths re-exposes ONLY takyon's own runtime dir (%U resolves to the manager
# uid 0 on this systemd, so the literal uid is required). All other isolation (NoNewPrivileges,
# ProtectSystem=strict, deno sandbox, cgroup caps) is unchanged. See dashboard unit.
ProtectHome=tmpfs
BindPaths=/run/user/995
ProtectSystem=strict
ReadWritePaths=/opt/takyon
ReadOnlyPaths=/opt/takyon/hermes-agent-main
WorkingDirectory=/opt/takyon/hermes-agent-main
EnvironmentFile=-/opt/takyon/.takyon/.env
EnvironmentFile=-/opt/takyon/secrets/.env
# Client planes may read non-secret runtime config from the env files, but paid-provider
# credentials must stay behind the safebox/broker authority and must not be resident in
# worker process env.
UnsetEnvironment=ANTHROPIC_API_KEY ANTHROPIC_TOKEN CLAUDE_CODE_OAUTH_TOKEN OPENAI_API_KEY OPENAI_KEY AZURE_OPENAI_API_KEY AZURE_OPENAI_KEY TAVILY_API_KEY TAKYON_GEMINI_API_KEY GEMINI_API_KEY GOOGLE_API_KEY FAL_KEY FAL_API_KEY REPLICATE_API_TOKEN COMPOSIO_API_KEY AUTH0_CLIENT_SECRET AUTH0_SECRET STRIPE_SECRET_KEY POSTMARK_SERVER_TOKEN SUPABASE_S3_SECRET_ACCESS_KEY R2_S3_SECRET_ACCESS_KEY CLOUDFLARE_API_TOKEN VERCEL_TOKEN
Environment=TAKYON_HOME=/opt/takyon/.takyon
Environment=HOME=/opt/takyon
Environment=PYTHONUNBUFFERED=1
Environment=TAKYON_FORCE_RESTORE_BUNDLED_SKILLS=1
Environment=TAKYON_HOST_ROLE=operator
Environment=TAKYON_NODE_NAME=argon-alpha-14
Environment=TAKYON_PRODUCT_ACTIVATION_NODE=argon-alpha-14
Environment=TAKYON_STORAGE_BACKEND=supabase_s3
Environment=TAKYON_SAFEBOX_URL=http://10.116.0.2:8000
Environment=TAKYON_PROVIDER_BROKER=1
Environment=TAKYON_DOCKER_BROKER_URL=http://127.0.0.1:8011
Environment=TAKYON_DOCKER_BINARY=/opt/takyon/hermes-agent-main/scripts/takyon-docker-broker.py
Environment=TERMINAL_ENV=docker
Environment=TERMINAL_DOCKER_MOUNT_CWD_TO_WORKSPACE=true
Environment=TERMINAL_CONTAINER_PERSISTENT=false
# The worker now loads the shared Takyon env file directly before startup, and load_takyon_env() still
# remains the in-process fallback. The worker is inherently Postgres (jobs/wake_schedules are PG-only);
# it does NOT consult TAKYON_DB_BACKEND, and it raises loudly (invariant #8) if no DATABASE_URL is
# configured.
ExecStart=/opt/takyon/hermes-agent-main/.venv/bin/takyon-cli worker
Restart=always
RestartSec=5
# Give the worker time to finish the in-flight CEO turn on stop. If it overruns and is SIGKILLed,
# the job is left 'running' and the next worker's requeue_stale reclaims it and refunds its
# reservation — an interrupted wake is safe, never double-billed, never a fake completion.
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
