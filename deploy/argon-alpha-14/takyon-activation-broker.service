[Unit]
Description=Takyon Product Activation Broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Dedicated localhost authority for product activation. The dashboard and worker
# stay least-privilege as the non-root takyon user; this broker owns the narrow
# host mutations required for product service activation.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/takyon
ReadWritePaths=/etc/systemd/system
ReadWritePaths=/etc/caddy
ReadOnlyPaths=/opt/takyon/hermes-agent-main
WorkingDirectory=/opt/takyon/hermes-agent-main
EnvironmentFile=-/opt/takyon/.takyon/.env
EnvironmentFile=-/opt/takyon/secrets/.env
Environment=TAKYON_HOME=/opt/takyon/.takyon
Environment=HOME=/root
Environment=PYTHONUNBUFFERED=1
Environment=TAKYON_HOST_ROLE=operator
ExecStart=/opt/takyon/hermes-agent-main/.venv/bin/python -m uvicorn plugins.takyon.product_activation_broker_app:app --host 127.0.0.1 --port 8012
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
