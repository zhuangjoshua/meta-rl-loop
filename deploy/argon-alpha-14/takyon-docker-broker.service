[Unit]
Description=Takyon Docker Broker
After=network-online.target
Wants=network-online.target
After=docker.service
Wants=docker.service

[Service]
Type=simple
# Dedicated authority holder for the host Docker daemon. Dashboard and worker no
# longer get docker-group/socket access directly; they talk to this local broker
# through the tracked TAKYON_DOCKER_BINARY shim instead.
User=takyon
Group=takyon
SupplementaryGroups=docker
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/takyon
ReadWritePaths=-/run/docker.sock
ReadOnlyPaths=/opt/takyon/hermes-agent-main
WorkingDirectory=/opt/takyon/hermes-agent-main
EnvironmentFile=-/opt/takyon/.takyon/.env
EnvironmentFile=-/opt/takyon/secrets/.env
# The broker process holds Docker authority only. Paid-provider credentials must stay
# behind safebox and must not be resident in this process env.
UnsetEnvironment=ANTHROPIC_API_KEY ANTHROPIC_TOKEN CLAUDE_CODE_OAUTH_TOKEN OPENAI_API_KEY OPENAI_KEY AZURE_OPENAI_API_KEY AZURE_OPENAI_KEY TAVILY_API_KEY TAKYON_GEMINI_API_KEY GEMINI_API_KEY GOOGLE_API_KEY FAL_KEY FAL_API_KEY REPLICATE_API_TOKEN COMPOSIO_API_KEY AUTH0_CLIENT_SECRET AUTH0_SECRET STRIPE_SECRET_KEY POSTMARK_SERVER_TOKEN SUPABASE_S3_SECRET_ACCESS_KEY R2_S3_SECRET_ACCESS_KEY CLOUDFLARE_API_TOKEN VERCEL_TOKEN
UnsetEnvironment=DATABASE_URL POSTGRES_URL POSTGRES_PRISMA_URL POSTGRES_URL_NON_POOLING SUPABASE_JWT_SECRET SUPABASE_SERVICE_ROLE_KEY STRIPE_WEBHOOK_SECRET STRIPE_BILLING_WEBHOOK_SECRET
UnsetEnvironment=TAKYON_CAP_SIGNING_KEY TAKYON_SAFEBOX_OPERATOR_TOKEN
Environment=TAKYON_HOME=/opt/takyon/.takyon
Environment=HOME=/opt/takyon
Environment=PYTHONUNBUFFERED=1
Environment=TAKYON_HOST_ROLE=operator
ExecStart=/opt/takyon/hermes-agent-main/.venv/bin/python -m uvicorn plugins.takyon.docker_broker_app:app --host 127.0.0.1 --port 8011
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
