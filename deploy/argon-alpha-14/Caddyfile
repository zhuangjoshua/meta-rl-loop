{
	auto_https disable_redirects
}

app.fourmanifold.com {
	reverse_proxy 127.0.0.1:9119
}

research-composer.fourmanifold.com {
	reverse_proxy 127.0.0.1:9120
}

:80 {
	@research_composer host research-composer.fourmanifold.com
	handle @research_composer {
		reverse_proxy 127.0.0.1:9120
	}

	@app host app.fourmanifold.com
	handle @app {
		reverse_proxy 127.0.0.1:9119 {
			header_up Host app.fourmanifold.com
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		respond "not found" 404
	}
}

# Legacy static product hosts. New companies should not add Caddy blocks; they
# should use the shared route above and Takyon's business-scoped product state.
