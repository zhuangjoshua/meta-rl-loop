{
	auto_https disable_redirects
	on_demand_tls {
		ask http://127.0.0.1:9119/api/product-tls/ask
	}
}

app.fourmanifold.com {
	reverse_proxy 127.0.0.1:9119
}

research-composer.fourmanifold.com {
	reverse_proxy 127.0.0.1:9120
}

https:// {
	tls {
		on_demand
	}

	@product {
		host *.fourmanifold.com
		not host app.fourmanifold.com www.fourmanifold.com admin.fourmanifold.com dashboard.fourmanifold.com research-composer.fourmanifold.com
		not host latexflow.fourmanifold.com e2e-postfix-05262217.fourmanifold.com longer.fourmanifold.com grantkit.fourmanifold.com inboxpilot.fourmanifold.com latexflow-0527124758.fourmanifold.com blog.fourmanifold.com
	}
	handle @product {
		reverse_proxy 10.116.0.3:80 {
			header_up Host {host}
			header_up X-Forwarded-Proto https
		}
	}

	respond "not found" 404
}

:80 {
	@research_composer host research-composer.fourmanifold.com
	handle @research_composer {
		reverse_proxy 127.0.0.1:9120
	}

	@app host app.fourmanifold.com
	handle @app {
		reverse_proxy 127.0.0.1:9119 {
			header_up Host app.fourmanifold.com
			header_up X-Forwarded-Proto https
		}
	}

	@product {
		host *.fourmanifold.com
		not host app.fourmanifold.com www.fourmanifold.com admin.fourmanifold.com dashboard.fourmanifold.com research-composer.fourmanifold.com
		not host latexflow.fourmanifold.com e2e-postfix-05262217.fourmanifold.com longer.fourmanifold.com grantkit.fourmanifold.com inboxpilot.fourmanifold.com latexflow-0527124758.fourmanifold.com blog.fourmanifold.com
	}
	handle @product {
		reverse_proxy 10.116.0.3:80 {
			header_up Host {host}
			header_up X-Forwarded-Proto http
		}
	}

	handle {
		respond "not found" 404
	}
}

# Legacy static product hosts. New companies should not add Caddy blocks; they
# should use the shared route above and Takyon's business-scoped product state.
