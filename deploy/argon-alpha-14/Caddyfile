{
	auto_https disable_redirects
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
	# Edge DDoS / abuse controls (the `Robustness` Caddy gap). `rate_limit` is the
	# mholt/caddy-ratelimit module, provisioned into the Caddy binary by
	# deploy/argon-alpha-14/bootstrap-host.sh (xcaddy build). Each zone is a sliding
	# window keyed per client IP ({client_ip}); a request over the window gets 429
	# with Retry-After. This is the network-layer complement to the per-user
	# api_rate_limits app rail (plugins/takyon/rate_limit.py), which it does not replace.
	order rate_limit before basic_auth
}

(fourmanifold_cloudflare_origin_tls) {
	tls /etc/ssl/certs/fourmanifold-cloudflare-origin.crt /etc/ssl/private/fourmanifold-cloudflare-origin.key
}

(coscale_cloudflare_origin_tls) {
	tls /etc/ssl/certs/coscale-cloudflare-origin.crt /etc/ssl/private/coscale-cloudflare-origin.key
}

(fourmanifold_edge_only) {
	@origin_bypass {
		not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32 127.0.0.1/8 ::1/128 10.116.0.0/20
	}
	respond @origin_bypass "forbidden" 403
}

# ── operator dashboard + control plane (app.fourmanifold.com -> :9119) ──────────────
app.fourmanifold.com {
	import fourmanifold_cloudflare_origin_tls
	import fourmanifold_edge_only

	# Compress static assets/responses at the edge. The Coscale JS bundle is ~469KB
	# and CSS ~148KB uncompressed; zstd/gzip cuts the first-load transfer ~3-4x.
	# Hashed assets are immutable-cached, so this only costs CPU on the cold load.
	encode zstd gzip

	# Tightest: credential endpoints (login/session/magic-link/oauth) — brute-force surface.
	@auth path /auth/* /api/sessions* /api/providers/oauth*
	rate_limit @auth {
		zone operator_auth {
			key {client_ip}
			events 30
			window 1m
		}
	}

	# Paid/form endpoints (checkout, topup, credits). Stripe-signed webhooks are
	# deliberately NOT rate-limited here: they are signature-verified + idempotent +
	# fail-closed in-app, arrive from shared Stripe IPs, and must survive provider retries.
	@forms {
		path /billing/topup/* /api/takyon/operator/topup/* /api/takyon/businesses/*/creative-credits/* /billing/checkout*
		not path /billing/webhook /api/webhooks/*
	}
	rate_limit @forms {
		zone operator_forms {
			key {client_ip}
			events 20
			window 1m
		}
	}

	# Broad API throttle (everything under /api except the signed webhooks).
	@api {
		path /api/*
		not path /api/webhooks/*
	}
	rate_limit @api {
		zone operator_api {
			key {client_ip}
			events 240
			window 1m
		}
	}

	# The product/app Stripe webhook (/api/webhooks/stripe) is an app-plane path the operator
	# dashboard (TAKYON_HOST_ROLE=operator) deliberately refuses with 404 — product-subscription
	# reconciliation belongs to the subuser/product plane (10.116.0.3:80, role=subuser), which owns
	# app_payments + the STRIPE_WEBHOOK_SECRET it verifies against. Route ONLY that path there so
	# app.fourmanifold.com/api/webhooks/stripe stays the one stable Stripe delivery URL. The
	# control-plane /v1/billing/webhook (STRIPE_BILLING_WEBHOOK_SECRET) stays on the operator dashboard.
	#
	# The subuser Caddy is Host-gated: its @product matcher forwards any *.fourmanifold.com EXCEPT the
	# reserved operator hostnames (app/skills/www/admin/dashboard/research-composer). Passing the real
	# Host (app.fourmanifold.com) is therefore rejected as "not found", so we rewrite Host to a stable
	# synthetic product host. The webhook handler dispatches purely on event metadata (business_slug),
	# not the Host, and role=subuser allows /api/webhooks/stripe for any host — so this host is just an
	# internal routing token (no DNS/TLS needed; the operator->subuser hop is plain HTTP on :80).
	handle /api/webhooks/stripe {
		reverse_proxy 10.116.0.3:80 {
			header_up Host stripe-webhooks.fourmanifold.com
			header_up X-Forwarded-Proto https
		}
	}
	handle {
		reverse_proxy 127.0.0.1:9119
	}
}

# Operator keeps ONLY app.fourmanifold.com (the Coscale workspace). Every other
# legacy operator subdomain (skills/admin/dashboard/www/research-composer)
# permanently redirects to it so old bookmarks/links land on the one UI.
skills.fourmanifold.com,
admin.fourmanifold.com,
dashboard.fourmanifold.com,
www.fourmanifold.com,
research-composer.fourmanifold.com {
	import fourmanifold_cloudflare_origin_tls
	import fourmanifold_edge_only
	redir https://app.fourmanifold.com{uri} 308
}

*.fourmanifold.com {
	import fourmanifold_cloudflare_origin_tls
	import fourmanifold_edge_only

	# Compress business product sites (slug.fourmanifold.com) at the edge too.
	encode zstd gzip

	@product {
		host *.fourmanifold.com
		not host app.fourmanifold.com skills.fourmanifold.com www.fourmanifold.com admin.fourmanifold.com dashboard.fourmanifold.com research-composer.fourmanifold.com
	}
	handle @product {
		reverse_proxy 10.116.0.3:80 {
			header_up Host {host}
			header_up X-Forwarded-Proto https
		}
	}

	respond "not found" 404
}

# Business product sites on the coscale.app domain. Same product plane (subuser 10.116.0.3:80) as
# *.fourmanifold.com, but terminated with coscale.app's own Cloudflare Origin cert. coscale.app has
# no reserved operator hosts, so every subdomain is a product host (the app runtime rejects any host
# that isn't a real business).
*.coscale.app {
	import coscale_cloudflare_origin_tls
	import fourmanifold_edge_only

	encode zstd gzip

	reverse_proxy 10.116.0.3:80 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
	}
}

:80 {
	import fourmanifold_edge_only

	# Legacy operator subdomains (skills/admin/dashboard/www/research-composer)
	# are handled by their dedicated 308-redirect site blocks above, which match
	# both :80 and :443 — no per-host plumbing needed here.

	@app host app.fourmanifold.com
	handle @app {
		reverse_proxy 127.0.0.1:9119 {
			header_up Host app.fourmanifold.com
			header_up X-Forwarded-Proto https
		}
	}

	@product {
		host *.fourmanifold.com *.coscale.app
		not host app.fourmanifold.com skills.fourmanifold.com www.fourmanifold.com admin.fourmanifold.com dashboard.fourmanifold.com research-composer.fourmanifold.com
	}
	handle @product {
		reverse_proxy 10.116.0.3:80 {
			header_up Host {host}
			header_up X-Forwarded-Proto http
		}
	}

	handle {
		respond "not found" 404
	}
}
