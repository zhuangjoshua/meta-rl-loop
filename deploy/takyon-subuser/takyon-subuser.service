[Unit]
Description=Takyon Sub-user Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Least privilege: dedicated `takyon` user (created by bootstrap-host.sh), filesystem read-only
# except /opt/takyon state, runtime tree pinned read-only. No docker group — this plane spawns no
# containers.
User=takyon
Group=takyon
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
MemoryAccounting=true
MemoryHigh=70%
MemoryMax=80%
OOMPolicy=stop
ReadWritePaths=/opt/takyon
ReadOnlyPaths=/opt/takyon/hermes-agent-main
WorkingDirectory=/opt/takyon/hermes-agent-main
EnvironmentFile=-/opt/takyon/.takyon/.env
EnvironmentFile=-/opt/takyon/secrets/.env
# Product runtime may read non-secret runtime config from the env files, but paid-provider
# credentials must stay behind the safebox/broker authority and must not be resident in
# sub-user process env.
UnsetEnvironment=ANTHROPIC_API_KEY ANTHROPIC_TOKEN CLAUDE_CODE_OAUTH_TOKEN OPENAI_API_KEY OPENAI_KEY AZURE_OPENAI_API_KEY AZURE_OPENAI_KEY TAVILY_API_KEY TAKYON_GEMINI_API_KEY GEMINI_API_KEY GOOGLE_API_KEY FAL_KEY FAL_API_KEY REPLICATE_API_TOKEN COMPOSIO_API_KEY AUTH0_CLIENT_SECRET AUTH0_SECRET STRIPE_SECRET_KEY POSTMARK_SERVER_TOKEN SUPABASE_S3_SECRET_ACCESS_KEY R2_S3_SECRET_ACCESS_KEY CLOUDFLARE_API_TOKEN VERCEL_TOKEN
UnsetEnvironment=DATABASE_URL POSTGRES_URL POSTGRES_PRISMA_URL POSTGRES_URL_NON_POOLING SUPABASE_JWT_SECRET SUPABASE_SERVICE_ROLE_KEY STRIPE_WEBHOOK_SECRET STRIPE_BILLING_WEBHOOK_SECRET TAKYON_SAFEBOX_OPERATOR_TOKEN
UnsetEnvironment=TAKYON_OPERATOR_DATABASE_URL TAKYON_SAFEBOX_DATABASE_URL TAKYON_MIGRATION_DATABASE_URL MIGRATION_DATABASE_URL TAKYON_RUNTIME_DATABASE_URL
UnsetEnvironment=TAKYON_CAP_SIGNING_KEY
Environment=TAKYON_HOME=/opt/takyon/.takyon
Environment=HOME=/opt/takyon
Environment=PYTHONUNBUFFERED=1
Environment=TAKYON_DISABLE_LEGACY_SKILL_SYNC=1
Environment=TAKYON_DB_BACKEND=postgres
Environment=TAKYON_HOST_ROLE=subuser
Environment=TAKYON_ENV=prod
Environment=TAKYON_STRIPE_MODE=live
Environment=TAKYON_NODE_NAME=takyon-subuser
Environment=TAKYON_PRODUCT_ACTIVATION_NODE=argon-alpha-14
# Must match the operator's PUBLIC_COMPANY_BASE_DOMAIN: this product-serving plane parses the slug
# out of the incoming host with it, so coscale.app hosts resolve to a business here.
Environment=PUBLIC_COMPANY_BASE_DOMAIN=coscale.app
Environment=TAKYON_DASHBOARD_EMBEDDED_WORKER=0
Environment=TAKYON_SAFEBOX_URL=http://10.116.0.2:8000
Environment=TAKYON_PROVIDER_BROKER=1
# Stage 4a: run 2 stateless uvicorn workers so one slow broker/provider request cannot
# head-of-line block every product customer on this host. Only honored for
# TAKYON_HOST_ROLE=subuser (web_server.start_server); the operator dashboard stays
# single-process. The Supavisor pooler role was provisioned for the extra per-worker
# Postgres connections (subuser-hardening-plan-for-codex.md C1); each worker holds its own
# in-process pool sized by TAKYON_PG_POOL_SIZE (default 8).
Environment=TAKYON_UVICORN_WORKERS=2
ExecStart=/opt/takyon/hermes-agent-main/.venv/bin/takyon-cli dashboard --host 127.0.0.1 --port 9119 --no-open --skip-build
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
