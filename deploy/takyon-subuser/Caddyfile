{
	auto_https disable_redirects
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
	# Edge DDoS / abuse controls for the shared product plane. `rate_limit` is the
	# mholt/caddy-ratelimit module, provisioned by deploy/takyon-subuser/bootstrap-host.sh
	# (xcaddy build). Per-IP sliding windows; over-window requests get 429 + Retry-After.
	order rate_limit before basic_auth
}

(fourmanifold_cloudflare_origin_tls) {
	tls /etc/ssl/certs/fourmanifold-cloudflare-origin.crt /etc/ssl/private/fourmanifold-cloudflare-origin.key
}

(coscale_cloudflare_origin_tls) {
	tls /etc/ssl/certs/coscale-cloudflare-origin.crt /etc/ssl/private/coscale-cloudflare-origin.key
}

(bounded_request_body) {
	# Coarse edge ceiling. ASGI applies tighter route-specific and streamed-body limits.
	request_body {
		max_size 9MB
	}
}

(fourmanifold_edge_only) {
	@origin_bypass {
		not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32 127.0.0.1/8 ::1/128 10.116.0.0/20
	}
	respond @origin_bypass "forbidden" 403
}

# Legacy fourmanifold product subdomains no longer serve product traffic.
# The app runtime itself decides whether a hostname belongs to a real business;
# Caddy only forwards eligible coscale product hosts to the sub-user plane.
*.fourmanifold.com {
	import fourmanifold_cloudflare_origin_tls
	import fourmanifold_edge_only

	respond "not found" 404
}

:80 {
	import fourmanifold_edge_only
	import bounded_request_body

	# DO load balancer health check: probes GET /healthz on :80 from the VPC (10.116.0.0/20,
	# permitted by fourmanifold_edge_only above). Proxied to the runtime so it reflects real
	# subuser health. Placed before @product so a hostless health probe resolves here, not 404.
	@health path /healthz
	handle @health {
		reverse_proxy 127.0.0.1:9119 {
			header_up Host 127.0.0.1
		}
	}

	@product {
		host *.coscale.app
		not host app.fourmanifold.com skills.fourmanifold.com www.fourmanifold.com admin.fourmanifold.com dashboard.fourmanifold.com research-composer.fourmanifold.com
	}
	handle @product {
		@app_auth path_regexp app_auth ^/api/takyon/apps/[^/]+/auth/(request|session|verify)$
		rate_limit @app_auth {
			zone product_auth_80 {
				key {client_ip}
				events 30
				window 1m
			}
		}

		@app_auth_request path_regexp app_auth_request ^/api/takyon/apps/[^/]+/auth/request$
		rate_limit @app_auth_request {
			zone product_auth_request_80 {
				key {client_ip}
				events 5
				window 1m
			}
		}

		@app_checkout path_regexp app_checkout ^/api/takyon/apps/[^/]+/checkout$
		rate_limit @app_checkout {
			zone product_checkout_80 {
				key {client_ip}
				events 30
				window 1m
			}
		}

		rate_limit {
			zone product_all_80 {
				key {client_ip}
				events 600
				window 1m
			}
		}

		reverse_proxy 127.0.0.1:9119 {
			header_up Host {host}
			header_up X-Forwarded-Proto https
		}
	}

	respond "not found" 404
}

# Direct-edge product /api origin for the Phase B decoupling (CF worker -> subuser-direct).
# The worker forwards <slug>.coscale.app/api/* to subuser-origin.coscale.app (THIS host) via
# resolveOverride, preserving the original Host, so this block matches by the product slug.
# coscale Origin cert + edge-only (CF-IP 403) + per-IP rate zones renamed *_443 (so the sliding
# windows do NOT merge with the :80 zones). Dormant until the worker is re-pointed; it sits ready
# and locked to Cloudflare IPs BEFORE any subuser-origin DNS record exists, so the origin is never
# briefly open. Mirrors the operator's proven *.coscale.app block but proxies to its own :9119.
*.coscale.app {
	import coscale_cloudflare_origin_tls
	import fourmanifold_edge_only
	import bounded_request_body

	encode zstd gzip

	@app_auth_443 path_regexp app_auth_443 ^/api/takyon/apps/[^/]+/auth/(request|session|verify)$
	rate_limit @app_auth_443 {
		zone product_auth_443 {
			key {client_ip}
			events 30
			window 1m
		}
	}

	@app_auth_request_443 path_regexp app_auth_request_443 ^/api/takyon/apps/[^/]+/auth/request$
	rate_limit @app_auth_request_443 {
		zone product_auth_request_443 {
			key {client_ip}
			events 5
			window 1m
		}
	}

	@app_checkout_443 path_regexp app_checkout_443 ^/api/takyon/apps/[^/]+/checkout$
	rate_limit @app_checkout_443 {
		zone product_checkout_443 {
			key {client_ip}
			events 30
			window 1m
		}
	}

	rate_limit {
		zone product_all_443 {
			key {client_ip}
			events 600
			window 1m
		}
	}

	reverse_proxy 127.0.0.1:9119 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
	}
}
