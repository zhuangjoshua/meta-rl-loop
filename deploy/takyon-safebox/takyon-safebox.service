[Unit]
Description=Takyon Safebox
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Least privilege: dedicated `takyon` user (created by bootstrap-host.sh), filesystem read-only
# except /opt/takyon state, runtime tree pinned read-only.
User=takyon
Group=takyon
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
MemoryAccounting=true
MemoryHigh=70%
MemoryMax=80%
OOMPolicy=stop
ReadWritePaths=/opt/takyon
ReadOnlyPaths=/opt/takyon/hermes-agent-main
WorkingDirectory=/opt/takyon/hermes-agent-main
# The app reads TAKYON_SAFEBOX_TOKEN from process env and FAILS CLOSED (401-everything) when it is
# missing — safebox_app never falls back to load_takyon_env(), so the unit must load the shared env
# file. Provision TAKYON_SAFEBOX_TOKEN there before deploying this unit.
EnvironmentFile=-/opt/takyon/.takyon/.env
EnvironmentFile=-/opt/takyon/secrets/.env
UnsetEnvironment=DATABASE_URL POSTGRES_URL POSTGRES_PRISMA_URL POSTGRES_URL_NON_POOLING
UnsetEnvironment=TAKYON_OPERATOR_DATABASE_URL TAKYON_APP_DATABASE_URL TAKYON_MIGRATION_DATABASE_URL MIGRATION_DATABASE_URL TAKYON_RUNTIME_DATABASE_URL
Environment=TAKYON_HOME=/opt/takyon/.takyon
Environment=HOME=/opt/takyon
Environment=PYTHONUNBUFFERED=1
Environment=TAKYON_HOST_ROLE=safebox
# Must match the operator/subuser planes' PUBLIC_COMPANY_BASE_DOMAIN: the checkout redirect gate
# (_require_app_checkout_redirect_url) only allows <slug>.<this base>, so a stale value breaks every
# product checkout with stripe_redirect_not_allowed (2026-07-05 incident: secrets/.env still said
# fourmanifold.com after the coscale cutover). NOTE: EnvironmentFile= overrides Environment=, so a
# secrets/.env line for this var wins — keep that file in sync; this pin covers the file dropping it.
Environment=PUBLIC_COMPANY_BASE_DOMAIN=coscale.app
# Operator/infrastructure-only routes require this exact client allowlist in addition to the shared
# transport token and TAKYON_SAFEBOX_OPERATOR_TOKEN. Do not widen to 10.116.0.0/20; the sub-user host is
# 10.116.0.3 and must not mint operator capabilities or touch private workspace/provider infrastructure.
Environment=TAKYON_SAFEBOX_OPERATOR_CLIENTS=10.116.0.18
# Stage 4a: 2 stateless uvicorn workers so long provider brokering (Anthropic/Tavily/creative
# calls up to 180s) cannot exhaust one process. Safe for multi-process: every safebox handler is
# sync `def` (threadpool-run) and all mutable authority state (single-use nonces, usage/billing
# ledgers) lives in Postgres, not process memory. Set after the EnvironmentFiles so the unit's
# value wins.
Environment=TAKYON_UVICORN_WORKERS=2
# Bind the VPC interface only (10.116.0.2 is this host's private address — the same address the
# operator/subuser planes are pointed at via TAKYON_SAFEBOX_URL). Never bind 0.0.0.0: the public
# interface must not expose the secret authority even with token auth in front of it.
# The dependency environment is versioned outside the rsynced source tree. Deploy validates a
# hash-locked candidate, atomically advances this pointer, and retains the previous target.
ExecStart=/opt/takyon/venvs/safebox-current/bin/python -m uvicorn plugins.takyon.safebox_app:app --host 10.116.0.2 --port 8000 --workers ${TAKYON_UVICORN_WORKERS}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
