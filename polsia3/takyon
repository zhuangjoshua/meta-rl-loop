#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

if [ ! -x "$ROOT/node_modules/.bin/tsx" ]; then
  echo "takyon needs node_modules installed in $ROOT. Run npm install once." >&2
  exit 1
fi

for node_dir in /opt/homebrew/bin /usr/local/bin "$HOME/.volta/bin" "$HOME/.nvm/current/bin"; do
  if [ -x "$node_dir/node" ]; then
    export PATH="$node_dir:$PATH"
    break
  fi
done

if ! command -v node >/dev/null 2>&1; then
  echo "takyon could not find node on PATH." >&2
  echo "Install Node.js or add it to PATH, for example: export PATH=\"/opt/homebrew/bin:\$PATH\"" >&2
  exit 1
fi

exec node "$ROOT/node_modules/tsx/dist/cli.mjs" "$ROOT/scripts/takyon.ts" "$@"
