#!/usr/bin/env python3
"""Argon agent CLI launcher."""

import os


def bridge_argon_env() -> None:
    """Map Argon public env names to the embedded runtime's internal names."""
    for public, internal in {
        "ARGON_HOME": "HERMES_HOME",
        "ARGON_INFERENCE_MODEL": "HERMES_INFERENCE_MODEL",
        "ARGON_INFERENCE_PROVIDER": "HERMES_INFERENCE_PROVIDER",
    }.items():
        if os.environ.get(public) and not os.environ.get(internal):
            os.environ[internal] = os.environ[public]

if __name__ == "__main__":
    bridge_argon_env()
    from hermes_cli.main import main

    main()
