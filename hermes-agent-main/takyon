#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

find_python() {
  for candidate in \
    "$ROOT/.venv/bin/python" \
    "$HOME/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/bin/python3" \
    python3.13 python3.12 python3.11 python3
  do
    if [ -x "$candidate" ]; then
      py="$candidate"
    else
      py=$(command -v "$candidate" 2>/dev/null || true)
    fi
    [ -n "${py:-}" ] || continue
    if "$py" - "$@" <<'PY' >/dev/null 2>&1
import sys
raise SystemExit(0 if sys.version_info >= (3, 11) else 1)
PY
    then
      printf '%s\n' "$py"
      return 0
    fi
  done
  return 1
}

PYTHON=$(find_python) || {
  echo "takyon requires Python 3.11 or newer. Run setup-takyon.sh or install python3.11+." >&2
  exit 1
}

exec "$PYTHON" -c 'from plugins.takyon.cli import main; main()' "$@"
