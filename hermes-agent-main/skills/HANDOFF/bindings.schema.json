{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fourmanifold.com/schemas/takyon-skill-bindings-v1.json",
  "title": "Takyon skill HANDOFF bindings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode_tool_policy", "capabilities", "artifacts", "skill_policies"],
  "properties": {
    "schema_version": {"const": 1},
    "mode_tool_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interactive", "bootstrap", "wake"],
      "properties": {
        "interactive": {"$ref": "#/$defs/modePolicy"},
        "bootstrap": {"$ref": "#/$defs/modePolicy"},
        "wake": {"$ref": "#/$defs/modePolicy"}
      }
    },
    "capabilities": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adapter", "tools", "scope", "authority"],
        "properties": {
          "adapter": {"enum": ["mcp", "sandbox", "web"]},
          "tools": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "scope": {"enum": ["current_business", "current_workspace", "current_operator", "current_session"]},
          "authority": {"enum": ["operator_session", "explicit_operator_interaction", "creative_credit", "mobile_release", "none"]}
        }
      }
    },
    "artifacts": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paths", "publish", "receipt"],
        "properties": {
          "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "publish": {"type": "boolean"},
          "receipt": {"type": "string", "minLength": 1},
          "runtime_owned_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "skill_policies": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["allowed_modes"],
        "properties": {
          "allowed_modes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["interactive", "bootstrap", "wake"]}
          }
        }
      }
    }
  },
  "$defs": {
    "modePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_tools", "denied_capabilities", "denied_tools", "denied_write_paths"],
      "properties": {
        "baseline_tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "denied_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "denied_tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "denied_write_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
